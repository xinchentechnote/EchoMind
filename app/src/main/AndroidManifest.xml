<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 后台播放（docs/playback-design.md） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 转录长任务的前台通知（WorkManager setForeground） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 刻意**没有** INTERNET（FR-511，2026-10-15）：模型随安装包内置，就位走 assets 拷贝，
         全 App 没有任何在线调用，「离线听书」由清单层面可证（飞行模式验收见 docs/testing.md）。
         原「下载模型」路径已退出产品（HttpFetcher 仅存于测试）；若哪天要恢复，须连 FR-501 的口径一起改。 -->

    <!-- 音频通过 SAF 树授权读取，不需要 READ_EXTERNAL_STORAGE / READ_MEDIA_AUDIO -->

    <application
        android:name=".EchoMindApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EchoMind">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台播放：MediaSessionService 让通知栏/媒体键/车机等 MediaBrowser 客户端
             操作同一个 ExoPlayer（PlayerHolder）。前台服务类型必须是 mediaPlayback（Android 14+ 硬要求）。 -->
        <service
            android:name=".playback.EchoMindMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 转录任务的前台通知不是我们自己起服务，而是 WorkManager 的 SystemForegroundService 代发。
             Android 14+ 要求 service 元素上写明 foregroundServiceType，而 work-runtime 2.12.0 的清单里
             这一项是空的（实测合并结果：`<service android:name="androidx.work.impl.foreground.SystemForegroundService" … />`
             没有 type），于是 `setForeground()` 一调就 IllegalArgumentException 把进程打死。
             这里用 tools:node="merge" 把 type 补进它那条声明，与上面的 FOREGROUND_SERVICE_DATA_SYNC 权限配对。 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
