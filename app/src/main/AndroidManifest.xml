<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 后台播放（docs/playback-design.md） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 转录长任务的前台通知（WorkManager setForeground） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 只用于「把模型取回本机」（asr/HttpFetcher → ModelManager）。
         转录与播放本身不调任何在线 API：FR-501 的边界是「准备模型要联网，准备完飞行模式可用」。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 音频通过 SAF 树授权读取，不需要 READ_EXTERNAL_STORAGE / READ_MEDIA_AUDIO -->

    <application
        android:name=".EchoMindApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EchoMind">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台播放：MediaSessionService 让通知栏/媒体键/车机等 MediaBrowser 客户端
             操作同一个 ExoPlayer（PlayerHolder）。前台服务类型必须是 mediaPlayback（Android 14+ 硬要求）。 -->
        <service
            android:name=".playback.EchoMindMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
